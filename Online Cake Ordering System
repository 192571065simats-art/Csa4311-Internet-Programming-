
<!DOCTYPE html>
<html>
<head>
<title>Cake Shop</title>
</head>
<body>
<h1>Online Cake Shop</h1>

<h2>Available Cakes</h2>
<p>Chocolate Cake - Rs.500</p>
<p>Vanilla Cake - Rs.400</p>
<p>Strawberry Cake - Rs.600</p>

<h2>Order Cake</h2>
<input id="name" placeholder="Your Name">

<select id="cake">
<option>Chocolate Cake</option>
<option>Vanilla Cake</option>
<option>Strawberry Cake</option>
</select>

<button onclick="order()">Place Order</button>
<p id="result"></p>

<script>
function order(){
let n=document.getElementById('name').value;
let c=document.getElementById('cake').value;
if(n==''){
alert('Enter your name');
}else{
document.getElementById('result').innerText=
'Order placed: '+c+' for '+n;
}
}
</script>
</body>
</html>
