
<!DOCTYPE html>
<html>
<head>
<title>Hotel Booking</title>
</head>
<body>
<h1>ABC Hotel</h1>
<h2>Available Rooms</h2>
<p>Single Room - Rs.1000</p>
<p>Double Room - Rs.2000</p>
<p>Deluxe Room - Rs.3000</p>

<h2>Book a Room</h2>
<form onsubmit="book(event)">
<input id="n" placeholder="Your Name" required>
<select id="r">
<option>Single Room</option>
<option>Double Room</option>
<option>Deluxe Room</option>
</select>
<input id="d" type="date" required>
<button type="submit">Book Room</button>
</form>
<p id="out"></p>

<script>
function book(e){
e.preventDefault();
out.innerText='Room booked for '+n.value+
' on '+d.value;
}
</script>
</body>
</html>
