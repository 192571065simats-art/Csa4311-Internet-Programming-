
<!DOCTYPE html>
<html>
<head>
<title>Beauty Parlour</title>
</head>
<body>
<h2>Beauty Parlour Booking</h2>

<form onsubmit="book(); return false;">
Name: <input id="name" required><br><br>

Service:
<select id="service">
<option>Haircut</option>
<option>Facial</option>
<option>Makeup</option>
</select><br><br>

Date: <input type="date" required><br><br>

<button type="submit">Book Appointment</button>
</form>

<p id="result"></p>

<script>
function book() {
document.getElementById("result").innerHTML =
"Appointment booked successfully!";
}
</script>
</body>
</html>
