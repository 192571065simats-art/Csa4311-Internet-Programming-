
<!DOCTYPE html>
<html>
<head>
<title>Flight Booking</title>
</head>
<body>
<h1>Flight Reservation</h1>

<input id="from" placeholder="From City">
<input id="to" placeholder="To City">
<input id="date" type="date">

<button onclick="searchFlight()">Search Flight</button>
<p id="result"></p>

<h2>Book Ticket</h2>
<input id="name" placeholder="Passenger Name">
<button onclick="book()">Book Ticket</button>

<script>
function searchFlight(){
document.getElementById('result').innerText=
'Available Flight - Rs.3000';
}
function book(){
let n=document.getElementById('name').value;
if(n==''){
alert('Enter passenger name');
}else{
document.getElementById('result').innerText=
'Flight ticket booked for '+n;
}
}
</script>
</body>
</html>
